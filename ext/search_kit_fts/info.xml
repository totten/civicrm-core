<?xml version="1.0"?>
<extension key="search_kit_fts" type="module">
  <file>search_kit_fts</file>
  <name>search_kit_fts</name>
  <description>SearchKit Full-Text Search Extension</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Tim Otten</name>
      <email>totten@civicrm.org</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://civicrm.org</url>
    <url desc="Documentation">https://civicrm.org</url>
    <url desc="Support">https://civicrm.org</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-28</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <comments>Semantic versioning. For example, compatibility with "6.1" implies compatibility with "6.2".</comments>
    <ver>6.20</ver>
  </compatibility>
  <php_compatibility mode="list">
    <comments>Listed versions. For example, specify both "8.1" and "8.2".</comments>
    <ver>8.0</ver>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <comments>Listed versions. For example, specify both "4" and "5".</comments>
    <ver>5</ver>
  </smarty_compatibility>
  <comments>SearchKit FTS extension exporting displays as FTS entities</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/SearchKitFts</namespace>
    <format>25.10.2</format>
    <angularModule>crmSearchKitFts</angularModule>
    <setting-page-title>Full Text Search</setting-page-title>
  </civix>
  <mixins>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
    <mixin>setting-admin@1.0.1</mixin>
  </mixins>
</extension>
